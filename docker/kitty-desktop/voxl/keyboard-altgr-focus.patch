+	// What each physical key types with no modifier, in the viewer's own layout, when the
+	// browser tells (Chromium's Keyboard Map); else letters and digits by their code.
+	let layout: Map<string, string> | null = null;
+	navigator.keyboard
+		?.getLayoutMap?.()
+		.then((m) => (layout = m))
+		.catch(() => undefined);
+	const baseOf = (code: string): string | undefined => {
+		const known = layout?.get(code);
+		if (known) return known;
+		const m = /^(?:Key([A-Z])|Digit(\d))$/.exec(code);
+		return m ? (m[1] ?? m[2]).toLowerCase() : undefined;
+	};
+	// A character made with AltGr (Windows reports it as Control+Alt) or with Option on a Mac,
+	// such as @ on Spanish and Latin American keyboards: the modifiers only chose the
+	// character, so it is typed as itself, without Control or Alt held on the desktop
+	// (Ctrl+Alt+@ would be a shortcut there, not an @).
+	function composed(e: KeyboardEvent): boolean {
+		if (!e.ctrlKey && !e.altKey) return false;
+		if ([...e.key].length !== 1 || e.key === ' ') return false;
+		if (e.getModifierState?.('AltGraph')) return true;
+		if (!e.altKey || e.metaKey || (e.ctrlKey && isMac)) return false;
+		if (!isMac && !e.ctrlKey) return false;
+		const base = baseOf(e.code);
+		if (base === undefined) return !/^[a-z0-9]$/i.test(e.key);
+		return e.key.toLowerCase() !== base.toLowerCase() && !e.shiftKey;
+	}
+	const LIFTED = /^(Control|Alt)/;
+
