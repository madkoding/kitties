# Where the page is reached from (Caddy gets its certificate for it).
KITTIES_DOMAIN=kitties.example.com
# The password of the page: openssl rand -hex 24
KITTIES_TOKEN=
# The group id of the docker socket on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Where the gateway keeps its state and the kitties' workspaces (a host folder).
KITTIES_DATA=/var/lib/kitties
# The keys of the models you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
