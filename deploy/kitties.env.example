# Read by the systemd unit. Keep it mode 0600.
# Behind a reverse proxy on this machine: listen on loopback and say where the page is reached.
KITTIES_LISTEN=127.0.0.1:7488
KITTIES_PUBLIC_URL=https://kitties.example.com
# The password of the page: openssl rand -hex 24
KITTIES_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
